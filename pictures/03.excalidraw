      "link": null,
      "locked": false,
      "text": "01 Count letters times charCodeAt - 97",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "01 Count letters times charCodeAt - 97",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PWlOPBPgfHxsEIg_3gEjs",
      "type": "text",
      "x": 637.7716069032284,
      "y": 1741.1170980965153,
      "width": 522.6395263671875,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 124873109,
      "version": 95,
      "versionNonce": 2031676411,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785782016977,
      "link": null,
      "locked": false,
      "text": "function commonCharsMap(words: string[]): string[] {\n  const A = 'a'.charCodeAt(0); // 97\n\n  const counts = (word: string): number[] => {\n    const jars = new Array<number>(26).fill(0);\n    for (let i = 0; i < word.length; i++) {\n      const s = word.charCodeAt(i) - A;\n      jars[s] += 1;\n    }\n    return jars\n  }\n\n  return [];\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function commonCharsMap(words: string[]): string[] {\n  const A = 'a'.charCodeAt(0); // 97\n\n  const counts = (word: string): number[] => {\n    const jars = new Array<number>(26).fill(0);\n    for (let i = 0; i < word.length; i++) {\n      const s = word.charCodeAt(i) - A;\n      jars[s] += 1;\n    }\n    return jars\n  }\n\n  return [];\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "G2S4Bzs7E6H818XQLFJzV",
      "type": "text",
      "x": 511.28723190322853,
      "y": 1710.819479048896,
      "width": 1180,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
