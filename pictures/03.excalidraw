      "versionNonce": 1498616757,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785782017344,
      "link": null,
      "locked": false,
      "text": "┌─────┬──────┬───────────────┬───────────────┬────────────┐\n│  i  │ char│ charCodeAt(i)│ s = code − 97│   effect   │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 0   │ b  │ 98           │ 1             │ jar 1 → 1  │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 1   │ e   │ 101          │ 4             │ jar 4 → 1  │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 2   │ l   │ 108          │ 11            │ jar 11 → 1 │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 3   │ l   │ 108          │ 11            │ jar 11 → 2 │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 4   │ a  │ 97           │ 0             │ jar 0 → 1  │\n└─────┴──────┴───────────────┴───────────────┴────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────┬──────┬───────────────┬───────────────┬────────────┐\n│  i  │ char│ charCodeAt(i)│ s = code − 97│   effect   │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 0   │ b  │ 98           │ 1             │ jar 1 → 1  │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 1   │ e   │ 101          │ 4             │ jar 4 → 1  │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 2   │ l   │ 108          │ 11            │ jar 11 → 1 │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 3   │ l   │ 108          │ 11            │ jar 11 → 2 │\n├─────┼──────┼───────────────┼───────────────┼────────────┤\n│ 4   │ a  │ 97           │ 0             │ jar 0 → 1  │\n└─────┴──────┴───────────────┴───────────────┴────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
