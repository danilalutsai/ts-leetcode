      "updated": 1785782029433,
      "link": null,
      "locked": false,
      "text": "Example, jar b:\n- running shelf has 1 pebble\n- roller has 0 pebbles\n- smaller is 0 → running jar b becomes empty\n\nJar l:\n- running has 2\n- roller has 2\n- smaller is 2 → stays 2",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example, jar b:\n- running shelf has 1 pebble\n- roller has 0 pebbles\n- smaller is 0 → running jar b becomes empty\n\nJar l:\n- running has 2\n- roller has 2\n- smaller is 2 → stays 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
