    {
      "id": "SVtRVWvuK0dNaKXKRPTNZ",
      "type": "text",
      "x": -219.03750117796034,
      "y": -96.32270041693164,
      "width": 693,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3k",
      "roundness": null,
      "seed": 1445352897,
      "version": 726,
      "versionNonce": 1987694927,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785931755365,
      "link": null,
      "locked": false,
      "text": "function binarySearch(nums: number[], target: number): number {\n  let low: number = 0;\n  let high: number = nums.length - 1;\n\n  while (low <= high) {\n    const mid: number = Math.floor((low + high) / 2);\n\n    if (nums[mid] === target) {\n      return mid;\n    }\n\n    if (nums[mid] < target) {\n      low = mid + 1;\n    } else {\n      high = mid - 1;\n    }\n  }\n\n  return -1;\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function binarySearch(nums: number[], target: number): number {\n  let low: number = 0;\n  let high: number = nums.length - 1;\n\n  while (low <= high) {\n    const mid: number = Math.floor((low + high) / 2);\n\n    if (nums[mid] === target) {\n      return mid;\n    }\n\n    if (nums[mid] < target) {\n      low = mid + 1;\n    } else {\n      high = mid - 1;\n    }\n  }\n\n  return -1;\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
